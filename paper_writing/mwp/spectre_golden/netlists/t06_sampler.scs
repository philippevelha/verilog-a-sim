// t06_sampler -- golden reference for t06 (a): 1 GS/s photonic sampler, 64 pulses, 10.36 GHz tone; pulse charge on 0.8 pF (strobe 50 ps)
simulator lang=spectre
global 0
include "models.scs"
opts options reltol=1e-6 vabstol=1e-9 iabstol=1e-15 temp=27 tnom=27 gmin=1e-18 save=selected
X1 (a_re a_im nu) mwp_mll pavg_mw=1 frep=1e9 fwhm=2e-12 t0=0.5e-9 jit=0 seed0=1
Vrf (rf 0) vsource type=sine ampl=1.6 freq=10359375000
Vb (vb 0) vsource dc=2
X2 (a_re a_im b_re b_im bb_re bb_im rf 0 vb) mwp_mzm vpi=4 vpi_dc=4 rterm=0
Vk (k 0) vsource dc=3
X3 (b_re b_im a1 k) mwp_pd resp=0.8
X4 (bb_re bb_im a2 k) mwp_pd resp=0.8
C1 (a1 0) capacitor c=8e-13
C2 (a2 0) capacitor c=8e-13
R1 (a1 0) resistor r=1e13 isnoisy=no
R2 (a2 0) resistor r=1e13 isnoisy=no
save a1 a2
tr tran stop=6.4e-08 strobeperiod=50e-12
