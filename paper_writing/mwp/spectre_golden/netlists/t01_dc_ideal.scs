// t01_dc_ideal -- golden reference for t01 (a): bias sweep, ideal extinction
simulator lang=spectre
global 0
include "models.scs"
opts options reltol=1e-6 vabstol=1e-9 iabstol=1e-15 temp=27 tnom=27 gmin=1e-18 save=selected
X1 (a_re a_im nu) mwp_laser p_mw=10 
Vb (vb 0) vsource dc=2
X2 (a_re a_im b_re b_im bb_re bb_im rf 0 vb) mwp_mzm vpi=4 vpi_dc=4 
Vk (k 0) vsource dc=3
X3 (b_re b_im an k) mwp_pd resp=0.8 
Vrf (rf 0) vsource dc=0
Vs (an 0) vsource dc=0
save Vs:p
sw dc dev=Vb param=dc start=0 stop=8 step=0.25
