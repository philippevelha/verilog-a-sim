// t03_het_040g -- golden reference for t03 (a): two lasers 40 GHz apart on one photodiode (strobe T/64)
simulator lang=spectre
global 0
include "models.scs"
opts options reltol=1e-6 vabstol=1e-9 iabstol=1e-15 temp=27 tnom=27 gmin=1e-18 save=selected
X1 (a_re a_im nu1) mwp_laser p_mw=1
X2 (b_re b_im nu2) mwp_laser p_mw=2 df=40000000000
X3 (a_re a_im b_re b_im c_re c_im d_re d_im) mwp_coupler
Vk (k 0) vsource dc=3
X4 (c_re c_im an k) mwp_pd resp=0.8
Vs (an 0) vsource dc=0
save Vs:p
tr tran stop=5e-10 maxstep=3.90625e-13 strobeperiod=3.90625e-13
